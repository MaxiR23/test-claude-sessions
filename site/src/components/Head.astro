---
import Default from '@astrojs/starlight/components/Head.astro';
import { getEntry } from 'astro:content';
import { locales, localeBase } from '../locales.mjs';

const sites = Object.entries(locales).map(([key, { lang }]) => ({ base: localeBase(key), lang }));
const storageKey = 'site-locale';
const { lang, locale } = Astro.locals.starlightRoute;
const shareImage = new URL(`/og/${lang}.png`, Astro.site).href;
// The root home has the entry id `index`; a locale's home has the locale as its id.
const home = await getEntry('docs', locale ?? 'index');
const shareImageAlt = home!.data.hero!.title;
---

<Default />
<meta property="og:image" content={shareImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={shareImageAlt} />
<meta name="twitter:image" content={shareImage} />
<script is:inline define:vars={{ sites, storageKey }}>
	(() => {
		const localeOf = (pathname) =>
			sites.find(({ base }) => base !== '' && (pathname === base || pathname.startsWith(`${base}/`))) ||
			sites.find(({ base }) => base === '');

		// A choice made in the language select is stored. Starlight's own listener
		// on the select runs before this one (it sits on the select, ours on
		// document). The choice is still stored because changing the path only
		// schedules the navigation; this listener runs before the page unloads.
		document.addEventListener('change', (e) => {
			const select = e.target;
			if (!(select instanceof HTMLSelectElement) || !select.closest('starlight-lang-select')) return;
			try {
				localStorage.setItem(storageKey, localeOf(new URL(select.value, location.href).pathname).lang);
			} catch {}
		});

		// A stored choice wins. The browser's first preferred language is used only
		// when nothing is stored; anything unknown falls back to the root locale.
		let stored = null;
		try {
			stored = localStorage.getItem(storageKey);
		} catch {}
		const first = (navigator.languages && navigator.languages[0]) || navigator.language || '';
		const primary = first.toLowerCase().split('-')[0];
		const wanted =
			sites.find(({ lang }) => lang === stored) ||
			sites.find(({ lang }) => lang.toLowerCase().split('-')[0] === primary) ||
			sites.find(({ base }) => base === '');
		const current = localeOf(location.pathname);
		if (wanted !== current) {
			location.replace(wanted.base + (location.pathname.slice(current.base.length) || '/') + location.search + location.hash);
		}
	})();
</script>
