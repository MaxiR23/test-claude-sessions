---
import { Icon } from '@astrojs/starlight/components';

const stages = [
	{
		name: 'create-issue / refine-issue',
		note: 'abre o completa el issue',
		tag: 'skill',
		lines: [
			'`create-issue` abre el issue con `scripts/issue.sh`: un tipo y un título.',
			'`refine-issue` completa uno que ya existe.',
			'El cuerpo del issue es el alcance congelado del cambio.',
			'Una pregunta BLOCKING abierta frena el loop en ese issue, en cualquier etapa.',
		],
		link: { text: 'Issues', href: '/workflow/issues/' },
	},
	{
		name: 'plan-issue',
		note: 'obligatorio si cambia comportamiento',
		tag: 'agente',
		lines: [
			'Corre si el issue cambia comportamiento, una página, un componente o la estructura.',
			'Un typo o un ajuste de docs o config va directo a implementar.',
			'Escribe el plan archivo por archivo, con cómo se verifica.',
		],
		link: { text: 'Plan e implementación', href: '/workflow/plan-e-implementacion/' },
	},
	{
		name: 'implement-issue',
		note: 'código y gate',
		tag: 'agente',
		lines: [
			'Implementa el plan, o el issue directo si no hizo falta plan.',
			'Corre el gate una vez al final: el build del sitio, hasta tres intentos.',
			'No commitea: eso lo hace `ship`.',
		],
		link: { text: 'Plan e implementación', href: '/workflow/plan-e-implementacion/' },
	},
	{
		name: 'loop-path.sh',
		tag: 'script',
		lines: [
			'Mira los archivos cambiados e imprime `short` o `full`.',
			'`short`: todos son `.md` y ninguno es configuración del loop.',
			'Decide el script, no el criterio de la sesión.',
		],
		link: { text: 'Revisión', href: '/workflow/revision/' },
		branches: [
			{ arrow: '→ ', text: 'corto: pasa a `ship`' },
			{ arrow: '↓ ', text: 'completo: sigue con `review-changes`' },
		],
	},
	{
		name: 'review-changes',
		tag: 'agente',
		lines: [
			'Una pasada sobre el diff contra `origin/main` y lo no commiteado.',
			'Cada hallazgo necesita un escenario de falla o una regla que rompa.',
			'Solo lee: no corrige nada.',
		],
		link: { text: 'Revisión', href: '/workflow/revision/' },
		branches: [
			{ arrow: '→ ', text: 'sin hallazgos BLOCKING ni IMPORTANT: pasa a `ship`' },
			{ arrow: '↓ ', text: 'con hallazgos BLOCKING o IMPORTANT: sigue con `verify-findings`' },
		],
	},
	{
		name: 'verify-findings',
		tag: 'agente',
		lines: [
			'Relee el código real y separa problemas de falsos positivos.',
			'Deja la lista de qué corregir para `implement-issue`.',
		],
		link: { text: 'Revisión', href: '/workflow/revision/' },
	},
	{
		name: 'implement-issue (modo fix)',
		tag: 'agente',
		lines: [
			'Corrige solo lo confirmado, en un solo ciclo.',
			'Los hallazgos menores quedan anotados en el PR para la revisión.',
		],
		link: { text: 'Plan e implementación', href: '/workflow/plan-e-implementacion/' },
	},
	{
		name: 'ship',
		tag: 'skill',
		steps: ['prepare', 'publish'],
		lines: ['`prepare`: crea la rama y commitea.', '`publish`: pushea y abre el PR.'],
		link: { text: 'Rama, commit y publicación', href: '/workflow/publicacion/' },
	},
];

const parts = (text) => text.split('`'); // odd indexes are code
---


<ol class="loop-flow not-content" aria-label="Flujo del loop">
	{
		stages.map((stage, i) => (
			<li>
				{i > 0 && (
					<span class="connector" aria-hidden="true"><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>
				)}
				<details class="node">
					<summary class="toggle">
						<span class="head">
							<code class="name">{stage.name}</code>
							{stage.note && <span class="note">{stage.note}</span>}
						</span>
						<span class="chip">{stage.tag}</span>
						<span class="chevron" aria-hidden="true"><Icon name="down-caret" /></span>
						{stage.steps && (
							<span class="steps">
								{stage.steps.map((step, j) => (
									<Fragment>
										{j > 0 && <span class="sep" aria-hidden="true">›</span>}
										<code class="chip">{step}</code>
									</Fragment>
								))}
							</span>
						)}
					</summary>
					<div class="panel">
						<div class="panel-clip">
							<div class="panel-body">
								{stage.lines.map((line) => (
									<p class="line"><span class="prompt" aria-hidden="true">$ </span><span class="text">{parts(line).map((part, j) => (j % 2 === 1 ? <code>{part}</code> : part))}</span></p>
								))}
								<a class="more" href={stage.link.href}>{stage.link.text}<span class="more-arrow" aria-hidden="true"><Icon name="right-arrow" /></span></a>
							</div>
						</div>
					</div>
				</details>
				{stage.branches?.map((b) => (
					<span class="branch"><span class="arrow" aria-hidden="true">{b.arrow}</span>{parts(b.text).map((part, j) => (j % 2 === 1 ? <code>{part}</code> : part))}</span>
				))}
			</li>
		))
	}
</ol>

<script is:inline>
	(() => {
		const root = document.querySelector('.loop-flow');
		if (!root) return;
		const css = getComputedStyle(root);
		const ms = (name) => {
			const value = css.getPropertyValue(name).trim();
			return value.endsWith('ms') ? parseFloat(value) : parseFloat(value) * 1000;
		};
		const expand = ms('--duration-expand');
		const typeStart = ms('--duration-type-start');
		const typeChar = ms('--duration-type-detail');
		const typeGap = ms('--duration-type-gap');
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
		const stages = [...root.querySelectorAll('details.node')];
		const runs = new WeakMap();
		const later = (fn, delay) => setTimeout(fn, delay);

		// Puts every line back to its original markup, fully visible.
		const restore = (stage) => {
			runs.set(stage, (runs.get(stage) || 0) + 1);
			stage.querySelectorAll('.text').forEach((text) => {
				if (text.dataset.html !== undefined) text.innerHTML = text.dataset.html;
			});
			stage.querySelectorAll('.line').forEach((line) => line.removeAttribute('data-pending'));
			stage.querySelector('.more').removeAttribute('data-pending');
		};

		// Empties every line, then types them one after the other as plain text and
		// puts back each line's markup as soon as it is typed.
		const type = (stage) => {
			const token = (runs.get(stage) || 0) + 1;
			runs.set(stage, token);
			const alive = () => runs.get(stage) === token;
			const lines = [...stage.querySelectorAll('.line')];
			const more = stage.querySelector('.more');
			const plain = lines.map((line) => {
				const text = line.querySelector('.text');
				if (text.dataset.html === undefined) text.dataset.html = text.innerHTML;
				const value = text.textContent;
				text.textContent = '';
				line.setAttribute('data-pending', '');
				return value;
			});
			more.setAttribute('data-pending', '');
			let index = 0;
			const nextLine = () => {
				if (!alive()) return;
				if (index >= lines.length) {
					more.removeAttribute('data-pending');
					return;
				}
				const line = lines[index];
				const text = line.querySelector('.text');
				const value = plain[index];
				line.removeAttribute('data-pending');
				let count = 0;
				const step = () => {
					if (!alive()) return;
					count += 1;
					text.textContent = value.slice(0, count);
					if (count < value.length) {
						later(step, typeChar);
						return;
					}
					text.innerHTML = text.dataset.html;
					index += 1;
					later(nextLine, typeGap);
				};
				step();
			};
			later(nextLine, typeStart);
		};

		const open = (stage) => {
			stage.open = true;
			if (reduce.matches) {
				restore(stage);
				stage.setAttribute('data-expanded', '');
				return;
			}
			type(stage);
			// Two frames so the collapsed state is painted before it expands.
			requestAnimationFrame(() => requestAnimationFrame(() => stage.setAttribute('data-expanded', '')));
		};

		const close = (stage) => {
			stage.removeAttribute('data-expanded');
			const done = () => {
				if (stage.hasAttribute('data-expanded')) return;
				stage.open = false;
				restore(stage);
			};
			if (reduce.matches) done();
			else later(done, expand);
		};

		root.setAttribute('data-enhanced', '');
		stages.forEach((stage) => {
			stage.querySelector('summary').addEventListener('click', (event) => {
				event.preventDefault();
				if (stage.hasAttribute('data-expanded')) {
					close(stage);
					return;
				}
				stages.forEach((other) => {
					if (other !== stage && other.hasAttribute('data-expanded')) close(other);
				});
				open(stage);
			});
			// Focus inside a stage that is still typing completes it.
			stage.querySelector('.panel-body').addEventListener('focusin', () => restore(stage));
		});
	})();
</script>

<style>
	.loop-flow {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.node {
		display: block;
		padding: 0 var(--space-3);
		border: var(--border);
		border-radius: var(--radius-md);
		background: var(--sl-color-gray-6);
	}
	.node:hover {
		border-color: var(--color-accent-border);
	}
	.node[open] {
		border-color: var(--sl-color-text-accent);
	}
	code {
		font-family: var(--font-mono);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
		overflow-wrap: anywhere;
	}
	.note {
		font-family: var(--font-body);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.toggle {
		list-style: none;
		cursor: pointer;
		padding-block: var(--space-2);
		min-block-size: var(--size-touch);
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto auto;
		align-items: start;
		column-gap: var(--space-2);
	}
	.toggle::-webkit-details-marker {
		display: none;
	}
	.node[open] .name {
		color: var(--sl-color-text-accent);
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		column-gap: var(--space-2);
		align-items: baseline;
		min-inline-size: 0;
	}
	.head .note {
		flex-basis: 100%;
	}
	@media (min-width: 50rem) {
		.head .note {
			flex-basis: auto;
		}
	}
	.chip {
		font-family: var(--font-mono);
		font-size: var(--sl-text-2xs);
		font-weight: 400;
		color: var(--sl-color-gray-3);
		border: var(--border);
		border-radius: var(--radius-full);
		padding: 0 var(--space-2);
		white-space: nowrap;
	}
	.toggle > .chip {
		margin-block-start: var(--space-1);
	}
	.chevron {
		display: inline-flex;
		color: var(--sl-color-gray-3);
		margin-block-start: var(--space-1);
	}
	.node[open] .chevron {
		color: var(--sl-color-text-accent);
		rotate: var(--rotate-open);
	}
	.steps {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-1);
		padding-block-start: var(--space-2);
	}
	.sep {
		font-family: var(--font-mono);
		color: var(--sl-color-text-accent);
	}
	.panel {
		display: grid;
		grid-template-rows: 1fr;
	}
	.loop-flow[data-enhanced] .panel {
		grid-template-rows: 0fr;
	}
	.loop-flow[data-enhanced] .node[data-expanded] .panel {
		grid-template-rows: 1fr;
	}
	.panel-clip {
		overflow: hidden;
		min-block-size: 0;
	}
	.panel-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding-block: var(--space-1) var(--space-2);
	}
	.line {
		margin: 0;
		display: grid;
		grid-template-columns: 2ch minmax(0, 1fr);
		min-block-size: calc(var(--sl-text-xs) * var(--sl-line-height));
		font-family: var(--font-mono);
		font-size: var(--sl-text-xs);
		line-height: var(--sl-line-height);
		color: var(--sl-color-gray-3);
		overflow-wrap: anywhere;
	}
	.line code {
		font-size: var(--sl-text-xs);
		font-weight: 400;
	}
	.prompt {
		color: var(--sl-color-gray-3);
		white-space: pre;
	}
	.line[data-pending] .prompt {
		visibility: hidden;
	}
	.more {
		align-self: flex-end;
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		min-block-size: var(--size-touch);
		font-family: var(--font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}
	.more[data-pending] {
		visibility: hidden;
		opacity: 0;
	}
	.more-arrow {
		display: inline-flex;
	}
	@media (prefers-reduced-motion: no-preference) {
		.node {
			transition: border-color var(--duration-hover) ease;
		}
		.loop-flow[data-enhanced] .panel {
			transition: grid-template-rows var(--duration-expand) ease;
		}
		.chevron {
			transition:
				rotate var(--duration-expand) ease,
				color var(--duration-hover) ease;
		}
		.more {
			transition:
				opacity var(--duration-expand) ease,
				visibility var(--duration-expand);
		}
		.more-arrow {
			transition: translate var(--duration-hover) ease-out;
		}
		.more:is(:hover, :focus-visible) .more-arrow {
			translate: var(--space-1) 0;
		}
	}
	.branch {
		display: block;
		padding-inline-start: var(--space-4);
		padding-block-start: var(--space-1);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.branch code {
		font-weight: 400;
	}
	.arrow {
		color: var(--sl-color-text-accent);
		font-family: var(--font-mono);
	}
	.connector {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-1);
		padding-inline-start: var(--space-4);
		padding-block-end: var(--space-2);
	}
	.dot {
		display: block;
		inline-size: var(--size-dot);
		block-size: var(--size-dot);
		border-radius: var(--radius-full);
		background-color: var(--sl-color-text-accent);
		opacity: 0.6;
	}
	@media (prefers-reduced-motion: no-preference) {
		.dot {
			animation: dot-flow var(--duration-flow) ease-out infinite backwards;
		}
		.dot:nth-child(2) {
			animation-delay: calc(var(--duration-flow) / 6);
		}
		.dot:nth-child(3) {
			animation-delay: calc(var(--duration-flow) / 3);
		}
	}
	@keyframes dot-flow {
		from,
		to {
			opacity: 0.25;
		}
		40% {
			opacity: 1;
		}
	}
</style>
