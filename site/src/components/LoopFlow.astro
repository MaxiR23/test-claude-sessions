---
import { Icon } from '@astrojs/starlight/components';

const stages = [
	{
		name: 'create-issue / refine-issue',
		note: 'abre o completa el issue',
		tag: 'skill',
		lines: [
			'`create-issue` abre el issue con `scripts/issue.sh`: un tipo y un título.',
			'`refine-issue` completa uno que ya existe.',
			'El cuerpo del issue es el alcance congelado del cambio.',
			'Una pregunta BLOCKING abierta frena el loop en ese issue, en cualquier etapa.',
		],
		link: { text: 'Issues', href: '/workflow/issues/' },
	},
	{
		name: 'plan-issue',
		note: 'obligatorio si cambia comportamiento',
		tag: 'agente',
		lines: [
			'Corre si el issue cambia comportamiento, una página, un componente o la estructura.',
			'Un typo o un ajuste de docs o config va directo a implementar.',
			'Escribe el plan archivo por archivo, con cómo se verifica.',
		],
		link: { text: 'Plan e implementación', href: '/workflow/plan-e-implementacion/' },
	},
	{
		name: 'implement-issue',
		note: 'código y gate',
		tag: 'agente',
		lines: [
			'Implementa el plan, o el issue directo si no hizo falta plan.',
			'Corre el gate una vez al final: el build del sitio, hasta tres intentos.',
			'No commitea: eso lo hace `ship`.',
		],
		link: { text: 'Plan e implementación', href: '/workflow/plan-e-implementacion/' },
	},
	{
		name: 'loop-path.sh',
		tag: 'script',
		lines: [
			'Mira los archivos cambiados e imprime `short` o `full`.',
			'`short`: todos son `.md` y ninguno es configuración del loop.',
			'Decide el script, no el criterio de la sesión.',
		],
		link: { text: 'Revisión', href: '/workflow/revision/' },
		branches: [
			{ arrow: '→ ', text: 'corto: pasa a `ship`' },
			{ arrow: '↓ ', text: 'completo: sigue con `review-changes`' },
		],
	},
	{
		name: 'review-changes',
		tag: 'agente',
		lines: [
			'Una pasada sobre el diff contra `origin/main` y lo no commiteado.',
			'Cada hallazgo necesita un escenario de falla o una regla que rompa.',
			'Solo lee: no corrige nada.',
		],
		link: { text: 'Revisión', href: '/workflow/revision/' },
		branches: [
			{ arrow: '→ ', text: 'sin hallazgos BLOCKING ni IMPORTANT: pasa a `ship`' },
			{ arrow: '↓ ', text: 'con hallazgos BLOCKING o IMPORTANT: sigue con `verify-findings`' },
		],
	},
	{
		name: 'verify-findings',
		tag: 'agente',
		lines: [
			'Relee el código real y separa problemas de falsos positivos.',
			'Deja la lista de qué corregir para `implement-issue`.',
		],
		link: { text: 'Revisión', href: '/workflow/revision/' },
	},
	{
		name: 'implement-issue (modo fix)',
		tag: 'agente',
		lines: [
			'Corrige solo lo confirmado, en un solo ciclo.',
			'Los hallazgos menores quedan anotados en el PR para la revisión.',
		],
		link: { text: 'Plan e implementación', href: '/workflow/plan-e-implementacion/' },
	},
	{
		name: 'ship',
		tag: 'skill',
		steps: ['prepare', 'publish'],
		lines: ['`prepare`: crea la rama y commitea.', '`publish`: pushea y abre el PR.'],
		link: { text: 'Rama, commit y publicación', href: '/workflow/publicacion/' },
	},
];

const parts = (text) => text.split('`'); // odd indexes are code
---

<ol class="loop-flow not-content" aria-label="Flujo del loop">
	{
		stages.map((stage, i) => (
			<li>
				{i > 0 && (
					<span class="connector" aria-hidden="true"><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>
				)}
				<div class="node">
					<button type="button" class="toggle" id={`loop-flow-toggle-${i}`} aria-expanded="true" aria-controls={`loop-flow-panel-${i}`}>
						<span class="head">
							<code class="name">{stage.name}</code>
							{stage.note && <span class="note">{stage.note}</span>}
						</span>
						<span class="chip">{stage.tag}</span>
						<span class="chevron" aria-hidden="true"><Icon name="down-caret" /></span>
					</button>
					{stage.steps && (
						<span class="steps"><code class="chip">prepare</code><span class="sep" aria-hidden="true">›</span><code class="chip">publish</code></span>
					)}
					<div class="panel" id={`loop-flow-panel-${i}`} role="region" aria-labelledby={`loop-flow-toggle-${i}`}>
						<div class="panel-clip">
							<div class="panel-body">
								{stage.lines.map((line) => (
									<p class="line"><span class="prompt" aria-hidden="true">$ </span><span class="text">{parts(line).map((part, j) => (j % 2 === 1 ? <code>{part}</code> : part))}</span></p>
								))}
								<a class="more" href={stage.link.href}>{stage.link.text}<span class="more-arrow" aria-hidden="true"><Icon name="right-arrow" /></span></a>
							</div>
						</div>
					</div>
				</div>
				{stage.branches?.map((b) => (
					<span class="branch"><span class="arrow" aria-hidden="true">{b.arrow}</span>{parts(b.text).map((part, j) => (j % 2 === 1 ? <code>{part}</code> : part))}</span>
				))}
			</li>
		))
	}
</ol>

<script is:inline>
	(() => {
		const root = document.querySelector('.loop-flow');
		if (!root) return;
		const css = getComputedStyle(root);
		const ms = (name) => {
			const value = css.getPropertyValue(name).trim();
			return value.endsWith('ms') ? parseFloat(value) : parseFloat(value) * 1000;
		};
		const typeDelay = ms('--duration-type-detail');
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
		const nodes = [...root.querySelectorAll('.node')];
		let timer = null;

		const restore = (node) => {
			clearTimeout(timer);
			timer = null;
			node.querySelectorAll('.untyped').forEach((span) => {
				const prev = span.previousSibling;
				if (prev && prev.nodeType === 3) prev.data += span.textContent;
				span.remove();
			});
			node.querySelectorAll('.line').forEach((line) => line.removeAttribute('data-pending'));
			node.removeAttribute('data-typed');
		};
		const finish = (node) => {
			restore(node);
			node.setAttribute('data-typed', '');
		};
		const type = (node) => {
			if (reduce.matches) {
				finish(node);
				return;
			}
			const lines = [...node.querySelectorAll('.line')];
			lines.forEach((line) => line.setAttribute('data-pending', ''));
			let index = 0;
			let untyped = [];
			const next = () => {
				if (index >= lines.length) {
					node.setAttribute('data-typed', '');
					return;
				}
				const line = lines[index];
				line.removeAttribute('data-pending');
				const walker = document.createTreeWalker(line.querySelector('.text'), NodeFilter.SHOW_TEXT);
				const texts = [];
				while (walker.nextNode()) texts.push(walker.currentNode);
				untyped = texts.map((text) => {
					const span = document.createElement('span');
					span.className = 'untyped';
					span.textContent = text.data;
					text.data = '';
					text.after(span);
					return { text, span };
				});
				step();
			};
			const step = () => {
				const current = untyped.find((u) => u.span.textContent.length > 0);
				if (!current) {
					untyped.forEach((u) => u.span.remove());
					index += 1;
					next();
					return;
				}
				const rest = current.span.textContent;
				current.text.data += rest[0];
				current.span.textContent = rest.slice(1);
				timer = setTimeout(step, typeDelay);
			};
			next();
		};
		const setOpen = (node, open) => {
			node.toggleAttribute('data-open', open);
			node.querySelector('.toggle').setAttribute('aria-expanded', String(open));
			if (!open) restore(node);
		};

		nodes.forEach((node) => setOpen(node, false));
		root.setAttribute('data-enhanced', '');
		nodes.forEach((node) => {
			node.querySelector('.toggle').addEventListener('click', () => {
				const open = !node.hasAttribute('data-open');
				nodes.forEach((other) => setOpen(other, false));
				if (open) {
					setOpen(node, true);
					type(node);
				}
			});
			node.querySelector('.panel').addEventListener('focusin', () => {
				if (node.hasAttribute('data-open') && !node.hasAttribute('data-typed')) finish(node);
			});
		});
	})();
</script>

<style>
	.loop-flow {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.node {
		display: block;
		padding: 0 var(--space-3);
		border: var(--border);
		border-radius: var(--radius-md);
		background: var(--sl-color-gray-6);
	}
	code {
		font-family: var(--font-mono);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
		overflow-wrap: anywhere;
	}
	.line code {
		font-weight: 400;
	}
	.note {
		font-family: var(--font-body);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.toggle {
		appearance: none;
		background: none;
		border: 0;
		padding: var(--space-2) 0;
		margin: 0;
		font: inherit;
		color: inherit;
		text-align: start;
		cursor: pointer;
		inline-size: 100%;
		min-block-size: var(--size-touch);
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto auto;
		align-items: start;
		column-gap: var(--space-2);
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		column-gap: var(--space-2);
		align-items: baseline;
		min-inline-size: 0;
	}
	.head .note {
		flex-basis: 100%;
	}
	@media (min-width: 50rem) {
		.head .note {
			flex-basis: auto;
		}
	}
	.chip {
		font-family: var(--font-mono);
		font-size: var(--sl-text-2xs);
		font-weight: 400;
		color: var(--sl-color-gray-3);
		border: var(--border);
		border-radius: var(--radius-sm);
		padding: 0 var(--space-1);
		white-space: nowrap;
	}
	.toggle .chip {
		margin-block-start: var(--space-1);
	}
	.chevron {
		display: inline-flex;
		color: var(--sl-color-gray-3);
		margin-block-start: var(--space-1);
	}
	.steps {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-1);
		padding-block-end: var(--space-2);
	}
	.sep {
		font-family: var(--font-mono);
		color: var(--sl-color-gray-3);
	}
	.panel {
		display: grid;
		grid-template-rows: 1fr;
	}
	.panel-clip {
		overflow: hidden;
		min-block-size: 0;
	}
	.panel-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding-block: var(--space-1) var(--space-2);
	}
	.line {
		margin: 0;
		display: grid;
		grid-template-columns: 2ch minmax(0, 1fr);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		overflow-wrap: anywhere;
	}
	.prompt {
		font-family: var(--font-mono);
		color: var(--sl-color-gray-3);
		white-space: pre;
	}
	.more {
		align-self: flex-end;
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		min-block-size: var(--size-touch);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}
	.more-arrow {
		display: inline-flex;
	}
	.untyped {
		color: transparent;
	}
	.loop-flow[data-enhanced] .node[data-open] {
		border-color: var(--sl-color-text-accent);
	}
	.loop-flow[data-enhanced] .node[data-open] .name {
		color: var(--sl-color-text-accent);
	}
	.loop-flow[data-enhanced] .node[data-open] .chevron {
		rotate: var(--rotate-open);
	}
	.loop-flow[data-enhanced] .node:not([data-open]) .panel {
		grid-template-rows: 0fr;
		visibility: hidden;
	}
	.loop-flow[data-enhanced] .line[data-pending] {
		opacity: 0;
	}
	.loop-flow[data-enhanced] .node:not([data-typed]) .more:not(:focus-visible) {
		opacity: 0;
	}
	.loop-flow:not([data-enhanced]) .chevron {
		display: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		.loop-flow[data-enhanced] .panel {
			transition:
				grid-template-rows var(--duration-enter) ease-out,
				visibility var(--duration-enter);
		}
		.loop-flow[data-enhanced] .chevron {
			transition: rotate var(--duration-enter) ease-out;
		}
		.loop-flow[data-enhanced] .more {
			transition: opacity var(--duration-fade) ease;
		}
		.more-arrow {
			transition: translate var(--duration-hover) ease-out;
		}
		.more:is(:hover, :focus-visible) .more-arrow {
			translate: var(--space-1) 0;
		}
	}
	.branch {
		display: block;
		padding-inline-start: var(--space-4);
		padding-block-start: var(--space-1);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.branch code {
		font-weight: 400;
	}
	.arrow {
		color: var(--sl-color-text-accent);
		font-family: var(--font-mono);
	}
	.connector {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-1);
		padding-inline-start: var(--space-4);
		padding-block-end: var(--space-2);
	}
	.dot {
		display: block;
		inline-size: var(--size-dot);
		block-size: var(--size-dot);
		border-radius: var(--radius-full);
		background-color: var(--sl-color-text-accent);
		opacity: 0.6;
	}
	@media (prefers-reduced-motion: no-preference) {
		.dot {
			animation: dot-flow var(--duration-flow) ease-out infinite backwards;
		}
		.dot:nth-child(2) {
			animation-delay: calc(var(--duration-flow) / 6);
		}
		.dot:nth-child(3) {
			animation-delay: calc(var(--duration-flow) / 3);
		}
	}
	@keyframes dot-flow {
		from,
		to {
			opacity: 0.25;
		}
		40% {
			opacity: 1;
		}
	}
</style>
